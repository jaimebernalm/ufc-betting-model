# Copy to `.env` and fill in. Never commit the real `.env`.

# ── Kaggle ─────────────────────────────────────────────────────────────────
# Source dataset: mdabbert/ultimate-ufc-dataset
# Get credentials at https://www.kaggle.com/settings → "Create New Token"
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Kalshi (read-only market data) ─────────────────────────────────────────
# API key ID + path to the RSA private key Kalshi issues alongside it.
# Keep the .pem OUTSIDE this repository.
# Docs: https://trading-api.readme.io/reference/api-keys
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem
KALSHI_ENV=prod

# ── Notifications (optional) ───────────────────────────────────────────────
# ntfy.sh topic used to push bet recommendations to a phone.
# NOTE: the topic name IS the authentication — treat it as a secret.
NTFY_TOPIC=

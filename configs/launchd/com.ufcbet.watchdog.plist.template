<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the per-fight watchdog (macOS).

  Setup:
    1. Replace every {{PROJECT_ROOT}} with the absolute path to your clone
       and {{PYTHON}} with the absolute path to your virtualenv's python.
    2. Save as ~/Library/LaunchAgents/com.ufcbet.watchdog.plist
    3. launchctl load ~/Library/LaunchAgents/com.ufcbet.watchdog.plist

  Generate it with:
    sed -e "s|{{PROJECT_ROOT}}|$(pwd)|g" -e "s|{{PYTHON}}|$(which python)|g" \
        configs/launchd/com.ufcbet.watchdog.plist.template \
        > ~/Library/LaunchAgents/com.ufcbet.watchdog.plist

  The watchdog only computes recommendations and sends notifications.
  It does not place orders.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ufcbet.watchdog</string>

    <!--
      Invoked as `python -m`, not via the `ufc-runner` console script. When the
      project path contains a space, pip generates a /bin/sh wrapper for console
      scripts, and launchd cannot execute it ("Operation not permitted").
      Calling the interpreter directly sidesteps that entirely.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>-m</string>
        <string>ufc_pred.cli.bet_runner</string>
        <string>--watchdog</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{PROJECT_ROOT}}/data/processed/bet_runner.log</string>

    <key>StandardErrorPath</key>
    <string>{{PROJECT_ROOT}}/data/processed/bet_runner.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>LegacyTimers</key>
    <true/>

    <key>LowPriorityIO</key>
    <false/>
</dict>
</plist>
